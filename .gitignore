__pycache__/
*.pyc
.venv/
infra/cdk.out/
# ...AND AT THE REPO ROOT. `cdk` writes its assembly to ./cdk.out relative to
# the WORKING DIRECTORY, not to the app file, so running
# `cdk deploy --app "python infra/app.py"` from the repo root writes here and
# not to the path above. On 2026-08-22 that put 3,697 files and 702,402 lines
# of vendored Lambda-layer wheels into a commit, because .gitignore only knew
# about the other spelling.
cdk.out/
loadtest/reports/
.milestone-active
# Loopback-shim pid files, written by `make baseline` / `make agent-evals`.
# Not ignoring them makes the tree dirty for the duration of the run, and
# run_evals.py --record refuses a dirty tree — so the harness would fail on
# a file the harness itself created, seconds after creating it.
*.pid
infra/cdk.context.json

# The Lambda dependency layer, built by `make layer` from requirements.txt.
# A build artifact and a large one (~101MB unzipped), rebuilt reproducibly from
# a pinned file — committing it would put wheels in git and let the layer drift
# from the pins that produced it.
build/

# Local Claude Code permission rules. `.claude/settings.json` holds the shared
# hooks and is tracked; this file holds allow-rules scoped to one operator's
# AWS account and machine, which are not a property of the project.
.claude/settings.local.json

# A mutation harness leaves one of these only while a mutation is applied
# (milestones/M06/*_guard_mutations.py). Committing one would be committing a
# mutated source waiting to be restored over a real edit.
*.mutation-backup
